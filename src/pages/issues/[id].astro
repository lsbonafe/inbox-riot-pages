---
import { getCollection, type CollectionEntry } from 'astro:content';
import Site from '../../layouts/Site.astro';
import ScribbleIcon from '../../components/ScribbleIcon.astro';
import StoryImage from '../../components/StoryImage.astro';
import { loadInstance } from '../../../config/instance.mjs';
import design from '../../../editorial/DESIGN_SYSTEM.json';

export async function getStaticPaths() {
  const issues = await getCollection('issues');
  return issues.map((issue) => ({ params: { id: issue.id }, props: { issue } }));
}

interface Props { issue: CollectionEntry<'issues'> }
const { issue } = Astro.props;
const { data } = issue;
const instance = loadInstance();
const base = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}`;
const issueCover = data.cover ?? instance.covers?.[data.edition];
const issueColors = design.art.paletteSets[data.artPalette ?? 'cyan-ink'];
const issueStyle = data.schemaVersion === 2 ? `--issue-bg:${issueColors.background};--issue-light:${issueColors.light};--issue-mid:${issueColors.mid};--issue-accent:${issueColors.accent};--issue-dark:${issueColors.dark}` : undefined;
const sectionNames = { reads: 'THE READING ROOM', signals: 'SIGNAL DESK', releases: 'NEW RELEASES', offers: 'OFFERS WITH A POINT', noise: 'THE NOISE FLOOR' };
const sectionDescriptions = {
  reads: 'Articles and essays unpacked: the key facts, arguments, and takeaways.',
  signals: 'Specific changes and announcements explained in a few lines: what happened and why it matters.',
  releases: 'New tools and culture worth exploring, from software to films and games.',
  offers: 'Public offers and courses assessed for their value and terms.',
  noise: 'Hype and repeated low-value claims when the pattern itself matters.'
};
const sectionNavHints = { reads: 'ARTICLE TAKEAWAYS', signals: 'CHANGES TO WATCH', releases: 'OUT NOW', offers: 'PUBLIC OFFERS', noise: 'HYPE PATTERNS' };
const sectionOrder = ['reads', 'signals', 'releases', 'offers', 'noise'] as const;
const storiesById = new Map(data.stories.map((story) => [story.id, story]));
const readingBeats = [
  { id: 'engineering', title: 'THE ENGINE ROOM' },
  { id: 'economics', title: 'THE MONEY PIT' },
  { id: 'accountability', title: 'THE CONTROL ROOM' },
  { id: 'frontier', title: 'THE LAB BENCH' },
  { id: 'culture', title: 'THE HUMAN SIDE' }
] as const;
---

<Site title={data.title} description={data.dek} theme={data.schemaVersion === 2 ? 'xerox' : undefined}>
  <article class:list={['issue-shell', { 'revised-issue': data.schemaVersion === 2 }]} style={issueStyle}>
    <header class="issue-hero">
      <div class="issue-meta"><span>ISSUE #{String(data.edition).padStart(2, '0')}</span><time datetime={data.date}>{data.date}</time><span>{data.stories.length} STORIES</span></div>
      <h1><span>{data.title}</span></h1><p class="issue-dek">{data.dek}</p>
      {issueCover && <figure class="issue-cover"><img src={`${base}${issueCover.src}`} alt={issueCover.alt} /></figure>}
      <div class="issue-note-stack">
        {data.revisedAt && <p class="issue-revision">REVISED <time datetime={data.revisedAt}>{data.revisedAt}</time></p>}
        <p class="editor-note"><strong>EDITOR'S NOTE /</strong> {data.editorNote}</p>
      </div>
    </header>

    <div class="issue-content">
      <nav class="issue-toc" aria-label="Issue sections"><strong>IN THIS ISSUE</strong><ol>
        <li><a class="toc-entry" href="#frontline"><ScribbleIcon name="frontline" /><span>The front line<small>THE BIG TAKEAWAYS</small></span></a></li>
        {data.fieldNotes?.length && <li><a class="toc-entry" href="#field-notes"><ScribbleIcon name="field-notes" /><span>Field notes<small>LIFE BETWEEN THE LINKS</small></span></a></li>}
        {sectionOrder.filter((section) => data.stories.some((story) => story.section === section)).map((section) => <li><a class="toc-entry" href={`#${section}`}><ScribbleIcon name={section} /><span>{sectionNames[section]}<small>{sectionNavHints[section]}</small></span></a></li>)}
      </ol><a class="back-home" href={base}>← ALL ISSUES</a></nav>

      <div class="issue-body">
        <section id="frontline" class="frontline"><div class="section-heading"><span class="kicker">THE MOST RELEVANT TOPICS</span><h2>THE FRONT LINE</h2></div>
          <ol class="lead-list">{data.leadTopics.map((topic, index) => <li id={`topic-${topic.id}`}>
            <span class="lead-index">0{index + 1}</span>
            <div class={`lead-layout${topic.image ? ' has-art' : ''}`}>
              <div class="lead-heading">
                <h3>{topic.title}</h3>
                <p class="lead-claim">{topic.claim}</p>
              </div>
              {topic.image && <StoryImage image={topic.image} base={base} className="lead-art" />}
              <div class="lead-details">
                <div class="lead-takeaway"><strong>THE TAKEAWAY /</strong><p>{topic.takeaway}</p></div>
                <p><strong>WHY IT MATTERS /</strong> {topic.whyItMatters}</p>
                <p><strong>STILL UNCLEAR /</strong> {topic.uncertainty}</p>
                <ul class="lead-sources">{topic.storyIds.map((storyId) => <li><a href={`#story-${storyId}`}>{storiesById.get(storyId)?.headline}</a></li>)}</ul>
              </div>
            </div>
          </li>)}</ol>
        </section>

        {data.fieldNotes?.length && <section id="field-notes" class="field-notes story-section">
          <div class="section-heading"><span class="kicker">LIFE BETWEEN THE LINKS</span><h2>FIELD NOTES</h2></div>
          <p class="section-intro">Small stories from my own week, with room for the detail that matters.</p>
          <div class="field-notes-grid">{data.fieldNotes.map((note, index) => <article class:list={['field-note', { 'field-note-featured': Boolean(note.sticker) }]}>
            {note.sticker && <img class="field-note-sticker" src={`${base}${note.sticker.src}`} alt={note.sticker.alt} loading="lazy" decoding="async" />}
            <span class="field-note-marker">PERSONAL DISPATCH / {String(index + 1).padStart(2, '0')}</span>
            <h3>{note.title}</h3>
            <p class="field-note-event">{note.event}</p>
            <p class="field-note-angle">{note.angle}</p>
            {note.contextLinks?.length && <div class="field-note-links">{note.contextLinks.map((link) => <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>)}</div>}
            <small>FROM THE INBOX / {note.sourceReference}</small>
          </article>)}</div>
        </section>}

        {sectionOrder.map((section) => {
          const stories = data.stories.filter((story) => story.section === section);
          if (!stories.length) return null;
          const features = stories.filter((story) => story.treatment !== 'brief');
          const briefs = stories.filter((story) => story.treatment === 'brief');
          const briefGroups = section === 'reads'
            ? [
                ...readingBeats.map((beat) => ({ ...beat, stories: briefs.filter((story) => story.beat === beat.id) })),
                { id: 'other', title: 'MORE READS', stories: briefs.filter((story) => !story.beat) }
              ].filter((group) => group.stories.length)
            : [{ id: section, title: 'QUICK TAKES', stories: briefs }];
          return <section id={section} data-section={section} class="story-section"><div class="section-heading"><span class="kicker">{String(stories.length).padStart(2, '0')} ITEMS</span><h2>{sectionNames[section]}</h2></div><p class="section-intro">{sectionDescriptions[section]}</p>
            {section === 'reads' && briefGroups.length > 1 && <nav class="beat-nav" aria-label="Reading room topics"><span>JUMP INTO THE PILE /</span>{briefGroups.map((group) => <a href={`#beat-${group.id}`}>{group.title} <b>{group.stories.length}</b></a>)}</nav>}
            {features.length > 0 && <div class="stories">{features.map((story) => <article id={`story-${story.id}`} class="story-card">
              <div class="story-header"><div class="story-tags"><span class="story-type">{section.toUpperCase()}</span></div><span class="story-source">{story.sourceName}</span></div>
              <h3>{story.headline}</h3>
              {story.image && <StoryImage image={story.image} base={base} sourceUrl={story.sourceUrl} className="story-image" />}
              <ul class="takeaways">{story.takeaways.map((takeaway) => <li>{takeaway}</li>)}</ul>
              <p class="why"><strong>WHY IT MATTERS /</strong> {story.whyItMatters}</p>
              {story.excerpt && <blockquote>{story.excerpt}</blockquote>}
              <div class="source-row">{story.sourceUrl ? <a href={story.sourceUrl} hreflang={story.sourceLanguage} target="_blank" rel="noopener noreferrer">READ THE SOURCE ↗</a> : <span>EMAIL EDITION / {story.emailReference}</span>}</div>
              {story.relatedLinks?.length && <div class="related-links"><span>DEEPER SOURCES /</span>{story.relatedLinks.map((link) => <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>)}</div>}
            </article>)}</div>}
            {briefGroups.map((group, groupIndex) => group.stories.length > 0 && <div class={`briefs${section === 'reads' ? ' reading-beat' : ''}`} id={`beat-${group.id}`}><h3 class="briefs-heading">{section === 'reads' ? <><span class="beat-kicker">READING ROOM / {String(groupIndex + 1).padStart(2, '0')}</span><span class="beat-title">{group.title}</span><span class="beat-count">{String(group.stories.length).padStart(2, '0')}<small>READS</small></span></> : `${group.title} / ${group.stories.length}`}</h3><ol class={`brief-list ${section === 'releases' ? 'release-grid' : ''}`}>{group.stories.map((story) => <li><article id={`story-${story.id}`} class="brief-row">{section === 'releases' && story.image && <StoryImage image={story.image} base={base} sourceUrl={story.sourceUrl} className="brief-image" />}<div class="brief-meta"><span>{story.sourceName}</span><span>{section.toUpperCase()}</span></div>{section !== 'releases' && story.image && <StoryImage image={story.image} base={base} sourceUrl={story.sourceUrl} className="brief-image" />}<h4>{story.headline}</h4><ul class="takeaways">{story.takeaways.map((takeaway) => <li>{takeaway}</li>)}</ul><p><strong>WHY IT MATTERS /</strong> {story.whyItMatters}</p>{story.sourceUrl ? <a class="brief-source" href={story.sourceUrl} hreflang={story.sourceLanguage} target="_blank" rel="noopener noreferrer">READ THE SOURCE ↗</a> : <span class="brief-source">EMAIL EDITION / {story.emailReference}</span>}{story.relatedLinks?.length && <div class="related-links"><span>DEEPER SOURCES /</span>{story.relatedLinks.map((link) => <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>)}</div>}</article></li>)}</ol></div>)}
          </section>;
        })}
      </div>
    </div>
  </article>
</Site>
