  signals: ['M5 34q6-7 12 0m-6-12q13-12 24 0m-15-11q11-5 20 4', 'm19 31 5-7 5 7-5 8Z'],
  releases: ['M5 14h34v25H5Zm0-8h34l-4 8H5Z', 'm13 6 5 8m6-8 5 8M12 25h20m-20 7h12'],
  offers: ['m5 8 21-3 14 15-18 20L5 25Z', 'M15 16h1m7 2 9 10m0-10-9 10'],
  noise: ['m5 11 7 6-4 6 11-3 4 12 7-10 9 8', 'M9 5 6 9m22-2 5-3m-1 34 6 2']
